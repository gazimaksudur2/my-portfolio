{
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev":           "vite",
    "build":         "vite build",
    "build:server":  "vite build --config vite.server.config.js",
    "prerender":     "npm run build && npm run build:server && node scripts/prerender.mjs",
    "lint":          "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview":       "vite preview",
    "deploy":        "npm run prerender && npx firebase-tools deploy",
    "firebase":      "npx firebase-tools"
  },
  "dependencies": {
    "@emailjs/browser":          "^4.4.1",
    "framer-motion":             "^12.40.0",
    "react":                     "^18.3.1",
    "react-dom":                 "^18.3.1",
    "react-icons":               "^5.2.1",
    "react-router-dom":          "^6.24.0"
  },
  "devDependencies": {
    "@types/react":              "^18.3.3",
    "@types/react-dom":          "^18.3.0",
    "@vitejs/plugin-react":      "^4.3.1",
    "autoprefixer":              "^10.4.19",
    "eslint":                    "^8.57.0",
    "eslint-plugin-react":       "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh":"^0.4.7",
    "firebase-tools":            "^13.0.0",
    "postcss":                   "^8.4.39",
    "tailwindcss":               "^3.4.4",
    "vite":                      "^5.3.1"
  }
}
